{
  // Soft-aligned to total-typescript bundler/no-dom (no extends): https://github.com/total-typescript/tsconfig
  // Never install or extend @total-typescript/tsconfig — keep settings inlined with these comments.
  // Deviation: do not set `lib` (template: ["ES2025"] only). bun-types augment DOM Response;
  // an explicit no-DOM lib leaves fetch incomplete, and `lib` + DOM duplicates Response.
  "include": ["**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "ES2025",
    "types": ["bun"],
    "module": "ESNext",

    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo-scripts"
  }
}
