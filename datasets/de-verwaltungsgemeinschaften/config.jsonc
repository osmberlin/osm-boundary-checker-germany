{
  "displayName": "Deutschland Verwaltungsgemeinschaften",
  "titlePrefix": "Verwaltungsgemeinschaft",
  "officialProfile": "bkg_vg25_vwg",
  "official": {
    // Pseudo-Verbände for verbandsfreie Gemeinden (BEM "gemeinschaftsfrei") share the geometry of
    // their Gemeinde and are already compared in the de-gemeinden-* datasets. Kreisfreie Städte
    // (BEM "kreisfrei") are already compared in de-landkreise and de-gemeinden-*. Drop both here.
    "extractFilter": {
      "property": "BEM",
      "excludeValues": ["gemeinschaftsfrei", "kreisfrei"],
    },
  },
  "osmProfile": "admin_rs",

  "idNormalization": {
    "preset": "regional-12",
  },
  "metricsCrs": "EPSG:25832",
  "compare": {
    "minZoom": 4,
    "officialMatchProperty": "ARS",
    "bboxFilter": "none",
    "osmScopeFilter": "none",
  },
  "osm": {
    // Verwaltungsgemeinschaften in OSM are expected at admin_level=7.
    "adminLevels": ["7"],
  },
}
