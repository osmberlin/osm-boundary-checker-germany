{
  "displayName": "Deutschland Naturschutzgebiete (DtP)",
  "titlePrefix": "Naturschutzgebiet",
  "officialProfile": "dtp_protected_areas",
  "osmProfile": "protected_area_wdpa",

  "official": {
    "dtp": {
      // DtP category ids (.cache/dtp/protected-area-categories.json): 2 Naturschutzgebiet, 50 Nationales Naturmonument.
      "categoryIds": [2, 50],
    },
  },
  "idNormalization": {
    "preset": "wdpa",
  },
  "metricsCrs": "EPSG:25832",
  "compare": {
    "minZoom": 5,
    // Embed the Wikidata item that DtP and OSM name into the feature shard (bun run wikidata:protected-areas).
    "wikidata": true,
    // Rules run in order; each only handles rows the earlier ones left unmatched, and an OSM object is used once.
    "matchRules": [
      // 1. The WDPA id (DtP areas without one carry a dtp-<uuid> key and can only match by 2 or 3).
      { "kind": "key", "officialProperty": "match_key", "osmTag": "ref:WDPA" },
      // 2. The OSM object DtP itself names (dtp_osm_ref, e.g. relation/123).
      { "kind": "osm_reference", "officialProperty": "dtp_osm_ref" },
      // 3. The OSM object tagged dtp_id=<DtP uuid>.
      { "kind": "osm_tag", "officialProperty": "dtp_uuid", "osmTag": "dtp_id" },
    ],
    // Attribute markers on the feature detail page (official property against OSM keys).
    "attributeChecks": [
      { "label": "Wikidata", "official": "wikidata", "osm": ["wikidata"] },
      // Combined name rule: name or official_name; a leading "NSG"/"Naturschutzgebiet" etc. is ignored.
      { "label": "Name", "official": "name", "osm": ["name", "official_name"], "compare": "name" },
      { "label": "WDPA-ID", "official": "wdpa", "osm": ["ref:WDPA"] },
      // category_id is the DtP category; equal when the OSM type tags fit its scope (protectedAreaCategories.ts).
      {
        "label": "Schutzkategorie",
        "official": "category_id",
        "osm": ["protection_title", "protect_class"],
        "compare": "protectedCategory",
      },
    ],
    "bboxFilter": "none",
    "osmScopeFilter": "none",
  },
  // Badge for areas that a protected-area authority maintains in DtP (property dtp_managed, written by the DtP extract).
  "rowFlags": [
    {
      "id": "managed",
      "officialProperty": "dtp_managed",
      "equals": true,
      "label": "Verwaltet",
      "hint": "Eine Schutzgebietsverwaltung pflegt dieses Gebiet bei Digitize the Planet; seine Regeln erscheinen in Outdoor-Apps.",
      "sortFirst": true,
      "detailProperty": "dtp_organizations",
      "detailLabel": "Zuständig",
    },
  ],
}
