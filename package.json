{
  "name": "osm-boundary-checker-germany",
  "private": true,
  "workspaces": [
    "scripts",
    "report"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "rust:build": "cargo build --release --manifest-path rust/geom-sidecar/Cargo.toml",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "type-check": "bun run --parallel type-check:*",
    "type-check:cli": "tsc --noEmit -p tsconfig.json",
    "type-check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "type-check:report": "tsc --noEmit -p report/tsconfig.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "test-run": "bun run --parallel test-run:*",
    "test-run:scripts": "bun test scripts/",
    "test-run:report-snapshot": "bun test report/prepareStaticSnapshotLib.test.ts",
    "test-run:report": "bun run --filter report test",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip-warn",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "compare": "bun run cli/compare.ts",
    "download": "bun run cli/download.ts",
    "extract": "bun run cli/extract.ts",
    "extract:osm": "bun run cli/extract-osm.ts",
    "extract:official": "bun run cli/extract-official.ts",
    "test": "bun run test-run",
    "german-key-lookup:update": "bun run --filter ./scripts german-key-lookup:update && oxfmt --write report/public/data/german-key-lookup.json",
    "german-key-lookup:weekly": "bun run --filter ./scripts german-key-lookup:weekly && oxfmt --write report/public/data/german-key-lookup.json",
    "changelog": "changelog --output-json-path report/public/changelog.gen.json --ignore-commit-term \"chore(data):\" && bun run format",
    "changelog:husky": "changelog --non-interactive --ci --validate --generate --output-json-path report/public/changelog.gen.json --ignore-commit-term \"chore(data):\"",
    "changelog:remap": "changelog --non-interactive --ci --remap-refs",
    "update": "bun run --sequential update:*",
    "update:deps": "bunx taze latest --include-locked --maturity-period 5 --interactive --write",
    "update:gitdeps": "bun update @tordans/changelog-kit",
    "update:app": "bun install && bun run check && bun run changelog"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tordans/changelog-kit": "github:tordans/changelog-kit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint-plugin-compat": "^7.0.2",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "patchedDependencies": {
    "osm2geojson-ultra@4.0.1": "patches/osm2geojson-ultra@4.0.1.patch"
  },
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
